# ---- Reservation API -------------------------------------------------------
# Where the mock reservation API lives. In docker-compose this is the service
# name; running locally it's localhost.
RESERVATION_API_URL=http://localhost:8000
API_TIMEOUT_S=8.0
# Transient-failure retries (503 / network). 1 == "retry at most once" (test T6).
API_MAX_RETRIES=1
API_RETRY_BACKOFF_MS=250

# ---- LLM (tool calling) ----------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ---- STT (streaming speech-to-text) ---------------------------------------
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# ---- TTS (streaming text-to-speech) ---------------------------------------
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=
# Default Cartesia voice (British Lady). Change to taste.
CARTESIA_VOICE_ID=79a125e8-cd45-4c13-8a67-188112f4dd22

# ---- Voice server ----------------------------------------------------------
HOST=0.0.0.0
PORT=7860

# ---- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
# Optional: also write structured logs to a file (JSON lines).
LOG_FILE=
